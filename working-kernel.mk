# Unofficial bring-up profile from the recovery-tested Evolution X 2026-09-30 kernel/module set.
# Source-kernel debugging remains available under FROGGER_KERNEL_PROFILE=source.
FROGGER_WORKING_KERNEL := $(DEVICE_PATH)/prebuilts/working-6.6.139
TARGET_PREBUILT_KERNEL := $(FROGGER_WORKING_KERNEL)/Image
BOARD_PREBUILT_DTBIMAGE_DIR := $(FROGGER_WORKING_KERNEL)/dtb
BOARD_PREBUILT_DTBOIMAGE := $(FROGGER_WORKING_KERNEL)/dtbo.img
BOARD_VENDOR_RAMDISK_KERNEL_MODULES := $(wildcard $(FROGGER_WORKING_KERNEL)/ramdisk/*.ko)
BOARD_VENDOR_RAMDISK_KERNEL_MODULES_LOAD := $(shell cat $(FROGGER_WORKING_KERNEL)/ramdisk/modules.load)
BOARD_RECOVERY_KERNEL_MODULES := $(BOARD_VENDOR_RAMDISK_KERNEL_MODULES)
BOARD_RECOVERY_KERNEL_MODULES_LOAD := $(shell cat $(FROGGER_WORKING_KERNEL)/ramdisk/modules.load.recovery)
BOARD_VENDOR_RAMDISK_RECOVERY_KERNEL_MODULES_LOAD := $(BOARD_RECOVERY_KERNEL_MODULES_LOAD)
BOARD_VENDOR_KERNEL_MODULES := $(wildcard $(FROGGER_WORKING_KERNEL)/vendor/*.ko)
BOARD_VENDOR_KERNEL_MODULES_LOAD := $(shell cat $(FROGGER_WORKING_KERNEL)/vendor/modules.load)
BOARD_VENDOR_KERNEL_MODULES_BLOCKLIST_FILE := $(FROGGER_WORKING_KERNEL)/vendor/modules.blocklist
BOARD_USES_VENDOR_DLKMIMAGE := true
BOARD_SYSTEM_KERNEL_MODULES := $(wildcard $(FROGGER_WORKING_KERNEL)/system/*.ko)
BOARD_SYSTEM_KERNEL_MODULES_LOAD := $(shell cat $(FROGGER_WORKING_KERNEL)/system/modules.load)
BOARD_SYSTEM_KERNEL_MODULES_BLOCKLIST_FILE := $(FROGGER_WORKING_KERNEL)/system/modules.blocklist
BOARD_USES_SYSTEM_DLKMIMAGE := true
# Keep the captured module signatures and payloads byte-for-byte.
BOARD_DO_NOT_STRIP_VENDOR_MODULES := true
BOARD_DO_NOT_STRIP_VENDOR_RAMDISK_MODULES := true
BOARD_DO_NOT_STRIP_RECOVERY_MODULES := true

# Header-only downstream checkout must not rebuild the captured working modules.
TARGET_KERNEL_DLKM_DISABLE := true
TARGET_KERNEL_DLKM_DISPLAY_OVERRIDE := false
AUDIO_DLKM_ENABLE := false
