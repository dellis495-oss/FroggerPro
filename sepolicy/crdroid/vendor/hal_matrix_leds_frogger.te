type hal_matrix_leds_default, domain;
type hal_matrix_leds_default_exec, exec_type, vendor_file_type, file_type;
type frogger_glyph_matrix_device, dev_type;

init_daemon_domain(hal_matrix_leds_default)
hal_server_domain(hal_matrix_leds_default, hal_matrix_leds)

allow hal_matrix_leds_default frogger_glyph_matrix_device:chr_file rw_file_perms;
# The stock Lights HAL also opens /dev/led_strips.
allow hal_light_default frogger_glyph_matrix_device:chr_file rw_file_perms;
allow hal_matrix_leds_default sysfs_leds:dir r_dir_perms;
allow hal_matrix_leds_default sysfs_leds:file rw_file_perms;
